@model HomeViewModel
@{ ViewData["Title"] = "Upcoming events"; }
<h1 class="mb-3">Upcoming events</h1>

<form method="get" class="card card-body mb-4">
  <div class="row g-2 align-items-end">
    <div class="col-md-3"><label class="form-label small mb-1">Search</label><input name="search" value="@Model.Search" class="form-control" placeholder="Name or description" /></div>
    <div class="col-md-2"><label class="form-label small mb-1">Type</label>
      <select name="type" class="form-select" asp-items="@(new SelectList(new[] { "Run", "Walk", "Cycle" }, Model.Type))"><option value="">All</option></select></div>
    <div class="col-md-2"><label class="form-label small mb-1">Location</label><input name="location" value="@Model.Location" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label small mb-1">From</label><input type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label small mb-1">To</label><input type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" /></div>
    <div class="col-md-1 d-grid"><button class="btn btn-rd" type="submit">Go</button></div>
  </div>
</form>

@if (Model.Events.Count == 0 && ViewData["Error"] is null)
{
    <p class="text-muted">No upcoming events match. Try clearing the filters.</p>
}
<div class="row g-4">
@foreach (var e in Model.Events)
{
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        @if (!string.IsNullOrEmpty(e.BannerUrl)) { <img class="card-img-top rd-banner" src="@e.BannerUrl" alt="@e.EventName banner" /> }
        else { <div class="card-img-top rd-banner"></div> }
        <div class="card-body d-flex flex-column">
          <span class="badge rd-role mb-2 align-self-start">@e.EventType</span>
          <h5 class="card-title">@e.EventName</h5>
          <p class="card-text text-muted">@e.EventDate.ToString("dddd, d MMMM yyyy")<br />@e.Location</p>
          <a class="btn btn-rd mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View details</a>
        </div>
      </div>
    </div>
}
</div>
