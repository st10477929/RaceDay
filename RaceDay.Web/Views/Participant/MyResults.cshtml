@model List<MyResultRow>
@{ ViewData["Title"] = "My results"; }
<h1 class="mb-3">My results</h1>
@if (Model.Count == 0) { <p class="text-muted">No results yet. Your race history appears here once an organiser captures your result.</p> }
else
{
  <div class="table-responsive"><table class="table align-middle bg-white">
    <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
      <tr>
        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@r.Result.EventId">@r.Result.EventName</a></td>
        <td>@(r.EventDate?.ToString("d MMM yyyy") ?? "-")</td>
        <td>@r.Result.CategoryName</td>
        <td>@UiHelpers.Time(r.Result.FinishTime)</td>
        <td>@UiHelpers.Ordinal(r.Result.Position)@(r.Finishers > 0 ? $" out of {r.Finishers} finishers" : "")</td>
      </tr>
    }
    </tbody></table></div>
}
