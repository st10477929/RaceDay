@model OrganiserResultsViewModel
@{ ViewData["Title"] = "Results entry"; }
<h1>Results entry</h1>
<p class="text-muted">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("d MMM yyyy"). Saved results are published straight away. Leave the time empty for a DNF.</p>
@if (Model.Enrolments.Count == 0) { <p class="text-muted">No enrolled participants yet.</p> }
else
{
  <div class="table-responsive"><table class="table align-middle bg-white">
    <thead><tr><th>Participant</th><th>Category</th><th style="min-width:380px">Finish time (hh:mm:ss) &amp; position</th></tr></thead>
    <tbody>
    @foreach (var en in Model.Enrolments)
    {
      Model.ResultsByEnrolment.TryGetValue(en.EnrolmentId, out var res);
      <tr>
        <td>@en.ParticipantName</td>
        <td>@en.CategoryName</td>
        <td>
          <form asp-action="SaveResult" method="post" class="row g-2 align-items-center">
            <input type="hidden" name="EventId" value="@Model.Event.EventId" />
            <input type="hidden" name="EnrolmentId" value="@en.EnrolmentId" />
            <input type="hidden" name="ResultId" value="@(res?.ResultId ?? 0)" />
            <div class="col"><input name="FinishTime" class="form-control form-control-sm" placeholder="00:48:35" value="@(res?.FinishTime is null ? "" : UiHelpers.Time(res.FinishTime))" /></div>
            <div class="col"><input name="Position" type="number" min="1" class="form-control form-control-sm" placeholder="Pos." value="@(res?.Position)" required /></div>
            <div class="col-auto"><button class="btn btn-rd btn-sm" type="submit">@(res is null ? "Publish" : "Update")</button></div>
          </form>
        </td>
      </tr>
    }
    </tbody></table></div>
}
<a class="btn btn-outline-secondary" asp-action="Events">&larr; My events</a>
