@model DashboardViewModel
@{ ViewData["Title"] = "Organiser dashboard"; }
<h1 class="mb-4">Organiser dashboard</h1>
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3"><div class="card card-body rd-stat"><div class="num">@Model.Events.Count</div>Events created</div></div>
  <div class="col-6 col-md-3"><div class="card card-body rd-stat"><div class="num">@Model.TotalEnrolments</div>Total enrolments</div></div>
  <div class="col-6 col-md-3"><div class="card card-body rd-stat"><div class="num">@Model.UpcomingCount</div>Upcoming events</div></div>
  <div class="col-6 col-md-3"><div class="card card-body rd-stat"><div class="num fs-5">@(Model.NextEvent?.EventDate.ToString("d MMM yyyy") ?? "None")</div>Next event</div></div>
</div>

@if (Model.Events.Count == 0)
{
  <p class="text-muted">You have not created any events yet.</p>
  <a class="btn btn-rd" asp-action="CreateEvent">Create your first event</a>
}
else
{
  <div class="table-responsive"><table class="table align-middle bg-white">
    <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Enrolments</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model.Events)
    {
      <tr>
        <td>@s.Event.EventName</td>
        <td>@s.Event.EventDate.ToString("d MMM yyyy") @if (s.Event.EventDate.Date >= DateTime.Today) { <span class="badge text-bg-success">Upcoming</span> } else { <span class="badge text-bg-secondary">Completed</span> }</td>
        <td>@s.Event.EventType</td>
        <td><strong>@s.Enrolments</strong></td>
        <td class="text-end"><a class="btn btn-outline-secondary btn-sm" asp-action="Enrolments" asp-route-eventId="@s.Event.EventId">View enrolments</a></td>
      </tr>
    }
    </tbody></table></div>
}
